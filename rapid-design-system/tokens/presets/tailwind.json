      "brand": { "primary": "#3b82f6", "secondary": "#2563eb", "tertiary": "#1d4ed8" },
      "surface": { "base": "#ffffff", "raised": "#f8fafc", "overlay": "#f1f5f9", "disabled": "#f1f5f9" },
      "text": { "primary": "#0f172a", "secondary": "#64748b", "disabled": "#94a3b8", "on-brand": "#ffffff", "link": "#2563eb", "link-hover": "#1d4ed8" },
      "border": { "default": "#e2e8f0", "strong": "#cbd5e1" },
