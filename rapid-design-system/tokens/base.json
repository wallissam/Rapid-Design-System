{
  "color": {
    "brand": {
      "primary": "#0f6cbd",
      "secondary": "#115ea3",
      "tertiary": "#0078d4"
    },
    "surface": {
      "base": "#ffffff",
      "raised": "#fafafa",
      "overlay": "#f5f5f5",
      "disabled": "#f0f0f0"
    },
    "text": {
      "primary": "#242424",
      "secondary": "#616161",
      "disabled": "#a0a0a0",
      "on-brand": "#ffffff",
      "link": "#0f6cbd",
      "link-hover": "#115ea3"
    },
    "border": {
      "default": "#d1d1d1",
      "strong": "#ababab"
    },
    "focus": {
      "ring": "#0f6cbd"
    },
    "status": {
      "info": "#0078d4",
      "success": "#0e7a0d",
      "warning": "#f7630c",
      "danger": "#b10e1c"
    }
  },
  "spacing": {
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "2xl": "48px"
  },
  "font": {
    "family": {
      "base": "'Segoe UI', -apple-system, BlinkMacSystemFont, 'Roboto', 'Helvetica Neue', sans-serif",
      "mono": "'Cascadia Code', 'Fira Code', 'Consolas', monospace"
    },
    "size": {
      "xs": "10px",
      "sm": "12px",
      "md": "14px",
      "lg": "18px",
      "xl": "24px",
      "2xl": "32px"
    },
    "weight": {
      "regular": "400",
      "semibold": "600",
      "bold": "700"
    },
    "line-height": {
      "tight": "1.2",
      "normal": "1.5",
      "relaxed": "1.75"
    },
    "letter-spacing": {
      "tight": "-0.02em",
      "normal": "0em",
      "wide": "0.05em"
    }
  },
  "radius": {
    "sm": "2px",
    "md": "4px",
    "lg": "8px",
    "xl": "12px",
    "round": "9999px"
  },
  "border": {
    "width": {
      "thin": "1px",
      "thick": "2px"
    }
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.12)",
    "md": "0 2px 4px rgba(0, 0, 0, 0.14)",
    "lg": "0 8px 16px rgba(0, 0, 0, 0.14)"
  },
  "focus": {
    "width": "2px",
    "offset": "2px"
  },
  "opacity": {
    "disabled": "0.4",
    "hover": "0.9",
    "subtle": "0.7"
  },
  "duration": {
    "fast": "100ms",
    "normal": "200ms",
    "slow": "400ms"
  },
  "easing": {
    "default": "cubic-bezier(0.4, 0, 0.2, 1)",
    "in": "cubic-bezier(0.4, 0, 1, 1)",
    "out": "cubic-bezier(0, 0, 0.2, 1)",
    "spring": "cubic-bezier(0.175, 0.885, 0.32, 1.275)"
  },
  "z": {
    "dropdown": "1000",
    "sticky": "1100",
    "overlay": "1300",
    "modal": "1400",
    "toast": "1500"
  }
}
